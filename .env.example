# PayOnProof configuration. Copy to .env and fill in what you need.
# The server reads .env on start (values are never printed). Real environment variables win over .env.
# With nothing set, it runs fully offline: offline sample parser (no AI) and PayPal not configured.

# --- Server -------------------------------------------------------------------
# Set by the host (Render). When set, the server binds 0.0.0.0:$PORT (and needs APPROVER_PASSCODE); otherwise 127.0.0.1:4410.
PORT=
# Extra host names allowed in the Host header, comma-separated (localhost and 127.0.0.1 are always allowed).
# Any other host name means the server is reachable from elsewhere, so it then needs APPROVER_PASSCODE.
ALLOWED_HOSTS=
# Absolute URL used in the approval links handed to MCP agents (optional; derived from the request otherwise).
# A URL that is not on this computer also needs APPROVER_PASSCODE.
PUBLIC_BASE_URL=
# 1 = trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (automatic on Render). The client address
# is the right-most X-Forwarded-For entry (appended by the proxy); anything a client puts to its left is ignored.
TRUST_PROXY=
# Set automatically by Render; listed here for completeness. Do not set them yourself.
# RENDER=
# RENDER_EXTERNAL_HOSTNAME=
# 0 = do not log one line per request.
LOG_REQUESTS=1

# --- AI extraction -----------------------------------------------------------
# offline | nebius | gemini | openai. Leave EMPTY to choose automatically: nebius if NEBIUS_API_KEY is set,
# gemini if GEMINI_API_KEY is set, openai if AI_BASE_URL is set, else offline.
# A value here wins over the keys below (AI_PROVIDER=offline would ignore every key).
AI_PROVIDER=
# NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible). Key from tokenfactory.nebius.com > API keys.
# Sent only as "Authorization: Bearer" to NEBIUS_BASE_URL.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# off = Nemotron answers without its hidden reasoning pass (faster and, in our live runs, more reliable); on = let it reason.
# With on, max_tokens is 16384 unless AI_MAX_OUTPUT_TOKENS says otherwise (the reasoning counts toward the output).
NEBIUS_REASONING=off
# Google Gemini (Google AI Studio key). Sent only in the x-goog-api-key header.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Any OpenAI-compatible chat completions endpoint, e.g. local Ollama: http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 0 = do not send response_format {type: json_object} (it is also dropped automatically if the server rejects it).
AI_JSON_MODE=1
# 0 = do not send each document's JSON Schema as structured output (response_format json_schema, strict) and use
# JSON mode only. Nebius and OpenAI-compatible endpoints; dropped automatically if the server rejects it.
AI_JSON_SCHEMA=1
# Optional max_tokens per model call (256-131072) for Nebius and OpenAI-compatible endpoints. Empty = the endpoint's
# default, or 16384 for Nebius with NEBIUS_REASONING=on.
AI_MAX_OUTPUT_TOKENS=
# Per model call, in milliseconds.
AI_TIMEOUT_MS=60000
# Safety budget for a public deployment: maximum model calls per hour for the whole server.
AI_MAX_CALLS_PER_HOUR=200
# Optional second budget over any 24 hours (empty = no daily limit). Keeps a public demo inside free credits.
AI_MAX_CALLS_PER_DAY=

# --- PayPal (sandbox) ---------------------------------------------------------
# 1 = MOCK PayPal: an in-process fake of the sandbox Payouts API. No network, clearly labelled in the UI.
PAYPAL_MOCK=
# developer.paypal.com > Apps & Credentials > Sandbox > your app (Payouts enabled).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox (default). The server refuses any other value, except the live URL https://api-m.paypal.com
# together with PAYPAL_ALLOW_LIVE below.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Live PayPal (real money) is off unless this is exactly I_UNDERSTAND and PAYPAL_BASE_URL=https://api-m.paypal.com.
# This project is built and tested for the sandbox and MOCK PayPal only: leave empty.
PAYPAL_ALLOW_LIVE=
# Sandbox testing aid: send every payout to this sandbox PERSONAL account email instead of the
# contract payee (the sample payees are fictional example.com addresses). Refused with live PayPal.
PAYEE_EMAIL_OVERRIDE=

# --- Paid-invoice ledger -------------------------------------------------------
# JSON file that remembers every invoice sent to PayPal (contract payee + invoice number), so no other case can pay
# it again. Default: data/ledger.json (relative paths start at the project folder). With MOCK PayPal it is kept in
# memory unless this is set. Render's free instances have no persistent disk: the file is lost on restart/redeploy.
LEDGER_PATH=

# --- Safety -------------------------------------------------------------------
# The approver passcode, at least 8 characters: what makes an approval a person's approval. REQUIRED whenever the
# server can be reached beyond this computer (PORT, RENDER, ALLOWED_HOSTS or PUBLIC_BASE_URL set); it refuses to start
# without it. Locally without it, any program that can send HTTP to 127.0.0.1 could approve. 20 wrong passcodes
# within 15 minutes lock approvals for everyone for 15 minutes.
APPROVER_PASSCODE=
# Optional: require "Authorization: Bearer <token>" on /mcp.
MCP_BEARER_TOKEN=
